  "narrative": {
    "northStar": "Dois mundos, a mesma dedicação",
    "overview": "Dois mundos de uma mesma pessoa: tecnologia e judô apresentados por personagens de anime em camadas sobre ambientes vazios. A identidade usa Archivo, fundo quase preto, vermelho discreto e painéis translúcidos para separar leitura e imagem. No judô, a marca Sakura fornecida pelo usuário e o acervo fotográfico real convivem com a abertura ilustrada; o texto permanece em superfícies escuras.\n\nO registro descreve a homepage estática em `portfolio/index.html`, com `style.css`, `worlds.css`, `worlds.js`, `sensei.css` e `sensei.js`. As páginas de cases e currículo conservam estilos independentes e não têm sua identidade redefinida aqui. A decisão atual em `PRODUCT.md` e `.impeccable/home-brief.md` substitui o contrato anterior de rolagem cinematográfica.",
    "keyCharacteristics": [
      "Personagens alpha derivados das artes autorizadas, ambientes mascarados e acervo real de judô.",
      "Archivo em títulos e texto, com hierarquia por escala e peso.",
      "Painéis escuros, bordas claras finas e acento vermelho restrito."
    ],
    "rules": [
      {
        "name": "The Texto sobre Painel Rule",
        "body": "Sobre a arte, preservar uma superfície escura entre texto e imagem.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do manter a leitura sobre painéis escuros ao sobrepor arte.",
      "Do preservar a troca reversível entre Tecnologia e Judô e o estado ativo na navegação.",
      "Do trocar imediatamente de mundo quando prefers-reduced-motion estiver ativo."
    ],
    "donts": [
      "Don't voltar à abertura longa controlada por rolagem: a seleção por clique a substituiu.",
      "Don't apresentar ilustração estática como filmagem de uma pessoa.",
      "Don't inventar conquistas, datas e graduação; preservar os fatos e o acervo autorizados da fonte Sensei."
    ]
  }
}
